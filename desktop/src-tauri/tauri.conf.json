{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NL2SQL",
  "version": "0.1.0",
  "identifier": "com.nonvegetable.nl2sql",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "NL2SQL", "width": 1280, "height": 820, "minWidth": 980, "minHeight": 650 }], "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:47821 https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com" } },
  "bundle": { "active": true, "targets": ["appimage", "deb", "dmg", "nsis"], "icon": ["icons/icon.png"], "externalBin": ["binaries/nl2sql-engine"] }
}
