# .env.example
# Copy this file to .env and replace the placeholder values with your actual credentials.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Admin connection used for reading schemas (sync_schema.py)
# Requires SELECT permissions on system catalogs to inspect tables and columns.
DATABASE_URL="postgresql+psycopg2://admin_user:admin_password@localhost:5432/your_db"

# Read-only connection used for securely executing generated queries (generate_sql.py)
# CRITICAL: Ensure this user only has SELECT privileges to prevent accidental data modification!
READONLY_DATABASE_URL="postgresql+psycopg2://readonly_user:readonly_password@localhost:5432/your_db"

# ---------------------------------------------------------------------------
# LLM (default: local LM Studio)
# ---------------------------------------------------------------------------

# Options: lmstudio | ollama | openai | anthropic | gemini
LLM_PROVIDER=lmstudio

# Optional. If unset (or the named model is not loaded), the app uses whatever
# chat model is currently loaded in LM Studio. Embedding models are ignored.
# LLM_MODEL_NAME=

# LM Studio server (Developer → Local Server, or `lms server start`).
# With or without the /v1 suffix is fine.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Dummy key — LM Studio does not validate it, but the OpenAI client requires a value.
LM_STUDIO_API_KEY=lm-studio

# ---------------------------------------------------------------------------
# Embeddings (default: LM Studio bundled nomic-embed-text)
# ---------------------------------------------------------------------------

# Options: lmstudio | ollama | openai
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_MODEL_NAME=text-embedding-nomic-embed-text-v1.5

# ---------------------------------------------------------------------------
# Optional: Ollama (kept for local fallback)
# ---------------------------------------------------------------------------

# The dashboard lists pulled chat models from this host and asks which to use.
# OLLAMA_HOST=http://localhost:11434
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME=mxbai-embed-large
# OLLAMA_URL=http://localhost:11434/api/embeddings

# ---------------------------------------------------------------------------
# Optional: Cloud APIs
# ---------------------------------------------------------------------------
# Keys can also be pasted in the Streamlit sidebar when you pick a provider.
# If a key is present, the app lists that account's chat models for you to choose.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
